# ─────────────────────────────────────────────
# IDE Nacional del Perú — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres123@ide-postgis:5432/ide
POSTGRES_PASSWORD=postgres123

# ── Authentication ────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change_me_in_production_long_random_string
JWT_EXPIRES=8h

# ── Admin seed user ───────────────────────────
# If ADMIN_PASSWORD is left empty the app will auto-generate one on first start
# and print it to the logs — change it immediately afterwards.
ADMIN_EMAIL=admin@ide.pe
ADMIN_PASSWORD=

# ── GeoServer ─────────────────────────────────
GEOSERVER_URL=http://ide-geoserver:8080/geoserver
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=geoserver

# ── GeoNetwork (external institutional instance) ──
# Leave blank to disable GeoNetwork integration.
GEONETWORK_URL=
GEONETWORK_USER=
GEONETWORK_PASS=

# ── File uploads ──────────────────────────────
UPLOAD_DIR=/uploads
UPLOAD_MAX_MB=500

# ── SMTP / Email ──────────────────────────────
# Leave SMTP_HOST blank to disable outbound email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@ide.pe

# ── Monitoring ────────────────────────────────
# How often (minutes) service health checks run
MONITOR_DEFAULT_INTERVAL_MIN=60
# Number of consecutive failures before an alert is raised
MONITOR_FAIL_THRESHOLD=3

# ── GDAL processing ───────────────────────────
# "docker"  → exec commands inside GDAL_CONTAINER via docker exec
# "local"   → run gdal* binaries installed on the host / in the app image
GDAL_MODE=docker
GDAL_CONTAINER=ide-gdal

# ── Node / Server ─────────────────────────────
NODE_ENV=production
PORT=3000
